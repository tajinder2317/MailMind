# MailMind Frontend Environment Variables

# Backend API Configuration
API_BASE_URL=http://localhost:8000

# Frontend Configuration
FRONTEND_PORT=8501
DEBUG_MODE=false

# Authentication (if needed)
USER_ID=demo_user

# Caching
CACHE_TTL=300  # seconds
ENABLE_CACHING=true

# Visualization Settings
MAX_GRAPH_NODES=50
GRAPH_LAYOUT=spring
SHOW_ENTITY_LABELS=true

# Search Settings
DEFAULT_SEARCH_LIMIT=10
SEARCH_TIMEOUT=30  # seconds

# Sync Settings
SYNC_REFRESH_INTERVAL=5  # seconds
AUTO_REFRESH_SYNC=true
