# =============================================================================
# MailMind Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL database connection
DATABASE_URL=postgresql+asyncpg://mailmind:your_secure_password@localhost:5432/mailmind
POSTGRES_PASSWORD=your_secure_password

# =============================================================================
# Gmail API Configuration
# =============================================================================
# Path to Gmail API credentials file (JSON format)
GMAIL_CREDENTIALS_PATH=config/credentials.json
# Directory to store Gmail OAuth tokens (one JSON per user_id/email)
GMAIL_TOKEN_DIR=tokens
# Optional: Use env-based OAuth credentials instead of a JSON file
# GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# =============================================================================
# Qdrant Vector Database Configuration
# =============================================================================
# Qdrant server URL
QDRANT_URL=http://localhost:6333
# Or run without a Qdrant server (embedded/local storage):
# QDRANT_URL=local
# Qdrant API key (if using cloud version)
# QDRANT_API_KEY=your_qdrant_api_key

# =============================================================================
# Application Configuration
# =============================================================================
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Maximum number of worker threads
MAX_WORKERS=10
# Debug mode (true/false)
DEBUG_MODE=false
# Default user ID for development (use your email address)
USER_ID=soorma2317@gmail.com

# =============================================================================
# Gmail Sync Configuration
# =============================================================================
# Maximum threads to fetch per sync operation
MAX_THREADS_PER_SYNC=100

# Gmail API rate limiting (requests per second)
GMAIL_RATE_LIMIT=10

# =============================================================================
# Embedding and AI Model Settings
# =============================================================================
# Groq Configuration (High-speed LLM)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
# Alternative Groq models:
# LLM_MODEL=llama-3.1-8b-instant
# LLM_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration (Fallback for embeddings if needed)
OPENAI_API_KEY=your_openai_api_key_here

# Embeddings provider:
# - local: free local embeddings (recommended if you don't want OpenAI)
# - openai: OpenAI embeddings
EMBEDDINGS_PROVIDER=local
# Local embedding model (FastEmbed)
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002

# Groq model for summarization
SUMMARY_MODEL=llama-3.3-70b-versatile

# Groq model for action item extraction
ACTION_MODEL=llama-3.3-70b-versatile

# Groq model for relationship mapping
RELATIONSHIP_MODEL=llama-3.3-70b-versatile

# Groq model for draft reply generation
DRAFT_REPLY_MODEL=llama-3.3-70b-versatile

# =============================================================================
# Rate Limiting Configuration (Groq Free Tier)
# =============================================================================
# Delay between LLM calls to prevent rate limiting (seconds)
LLM_CALL_DELAY=2

# Maximum concurrent LLM requests
MAX_CONCURRENT_LLM_REQUESTS=5

# Retry configuration for failed LLM calls
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=5

# To reduce Groq usage (helpful on free tier):
ENABLE_LLM_ACTION_EXTRACTION=true
ENABLE_SLIDING_CONTEXT_SUMMARY=true

# =============================================================================
# Processing Configuration
# =============================================================================
# Token limit for sliding context (before summarization)
SLIDING_CONTEXT_TOKEN_LIMIT=4000

# Target token count for summaries
SUMMARY_TARGET_TOKENS=800

# Minimum messages before triggering summarization
MIN_MESSAGES_FOR_SUMMARY=4

# Overlap tokens between context windows
CONTEXT_OVERLAP_TOKENS=200

# =============================================================================
# Attachment Processing Configuration
# =============================================================================
# Supported attachment types
SUPPORTED_ATTACHMENT_TYPES=pdf,docx,txt,jpg,jpeg,png

# OCR language for image processing
OCR_LANGUAGE=eng

# Maximum attachment size (MB)
MAX_ATTACHMENT_SIZE=25

# =============================================================================
# Vector Store Configuration
# =============================================================================
# Vector collection name
VECTOR_COLLECTION_NAME=mailmind_threads

# Embedding dimension
EMBEDDING_DIMENSION=1536

# Vector similarity threshold
SIMILARITY_THRESHOLD=0.7

# Maximum search results
MAX_SEARCH_RESULTS=20

# =============================================================================
# Frontend Configuration
# =============================================================================
# Frontend server port
FRONTEND_PORT=8501

# Frontend host address
FRONTEND_HOST=localhost

# Cache TTL for frontend (seconds)
FRONTEND_CACHE_TTL=300

# =============================================================================
# Security Configuration
# =============================================================================
# JWT secret key (generate a strong random string)
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT expiration time (hours)
JWT_EXPIRATION_HOURS=24

# CORS allowed origins
CORS_ORIGINS=http://localhost:8501,http://localhost:8000

# =============================================================================
# Monitoring and Logging Configuration
# =============================================================================
# Enable detailed logging
ENABLE_DETAILED_LOGGING=false

# Log file path
LOG_FILE_PATH=logs/mailmind.log

# Maximum log file size (MB)
MAX_LOG_FILE_SIZE=100

# Number of log files to keep
LOG_FILE_BACKUP_COUNT=5

# =============================================================================
# Development Configuration
# =============================================================================
# Enable debug endpoints
ENABLE_DEBUG_ENDPOINTS=false

# Enable profiling
ENABLE_PROFILING=false

# Test mode (uses mock data)
TEST_MODE=false

# =============================================================================
# Production Configuration
# =============================================================================
# Production environment flag
IS_PRODUCTION=false

# SSL certificate path
SSL_CERT_PATH=

# SSL key path
SSL_KEY_PATH=

# Trusted proxy IPs
TRUSTED_PROXY_IPS=127.0.0.1

# =============================================================================
# Feature Flags
# =============================================================================
# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable advanced analytics
ENABLE_ADVANCED_ANALYTICS=false

# Enable real-time updates
ENABLE_REAL_TIME_UPDATES=true

# Enable caching
ENABLE_CACHING=true

# Cache TTL (seconds)
CACHE_TTL=3600

# =============================================================================
# External Service Configuration
# =============================================================================
# Redis URL (for caching, if used)
REDIS_URL=redis://localhost:6379/0

# Elasticsearch URL (for search, if used)
ELASTICSEARCH_URL=http://localhost:9200

# Sentry DSN (for error tracking)
SENTRY_DSN=

# =============================================================================
# Performance Configuration
# =============================================================================
# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Database connection pool size
DB_POOL_SIZE=10

# Database max overflow connections
DB_MAX_OVERFLOW=20

# =============================================================================
# Email Configuration (for notifications)
# =============================================================================
# SMTP server
SMTP_SERVER=smtp.gmail.com

# SMTP port
SMTP_PORT=587

# SMTP username
SMTP_USERNAME=your_email@gmail.com

# SMTP password
SMTP_PASSWORD=your_app_password

# Email from address
EMAIL_FROM=your_email@gmail.com

# =============================================================================
# Backup Configuration
# =============================================================================
# Enable automatic backups
ENABLE_AUTO_BACKUP=false

# Backup interval (hours)
BACKUP_INTERVAL_HOURS=24

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup storage path
BACKUP_STORAGE_PATH=backups/

# =============================================================================
# API Rate Limiting
# =============================================================================
# Requests per minute per user
RATE_LIMIT_PER_MINUTE=100

# Requests per hour per user
RATE_LIMIT_PER_HOUR=1000

# Burst size for rate limiting
RATE_LIMIT_BURST_SIZE=10
